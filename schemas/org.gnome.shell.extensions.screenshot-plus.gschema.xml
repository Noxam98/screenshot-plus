<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.screenshot-plus" path="/org/gnome/shell/extensions/screenshot-plus/">
    <key name="video-codec" type="s">
      <default>'av1'</default>
      <summary>Codec for screen recordings: av1 or h264 (GNOME's own recorder)</summary>
    </key>
    <key name="text-style" type="s">
      <default>'{}'</default>
      <summary>Last used text style as JSON: fontPx, outlineColor, outlineWidth, bgColor, bgAlpha, bgPadX, bgPadY</summary>
    </key>
    <key name="tool-color" type="s">
      <default>'#e01b24'</default>
      <summary>Last used drawing colour</summary>
    </key>
    <key name="tool-width" type="i">
      <default>4</default>
      <range min="1" max="30"/>
      <summary>Last used line width</summary>
    </key>
  </schema>
</schemalist>
